:root {
  --bg-main: #0d1117;
  --bg-card: #161b22;
  --text-main: #c9d1d9;
  --text-muted: #8b949e;
  --accent: #58a6ff;
  --accent-hover: #1f6feb;
  --border: #30363d;
  --error: #f85149;
  --warning: #d29922;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: var(--bg-main);
  color: var(--text-main);
  line-height: 1.5;
}

.app-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.header {
  text-align: center;
  margin-bottom: 2rem;
}

.header h1 {
  font-size: 2.5rem;
  color: #fff;
}

.header p {
  color: var(--text-muted);
}

.main-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}

@media (min-width: 900px) {
  .main-grid {
    grid-template-columns: 1.5fr 1fr;
  }
}

.card {
  background-color: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}

.card h2 {
  font-size: 1.25rem;
  margin-bottom: 1rem;
  color: #fff;
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.5rem;
}

/* Tabs */
.tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.tabs button {
  flex: 1;
  background-color: transparent;
  color: var(--text-main);
  border: 1px solid var(--border);
  padding: 0.5rem;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.2s;
}

.tabs button.active {
  background-color: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

/* Inputs */
.input-group {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

input, textarea, select {
  width: 100%;
  padding: 0.75rem;
  background-color: var(--bg-main);
  border: 1px solid var(--border);
  color: var(--text-main);
  border-radius: 4px;
  font-family: inherit;
}

input:focus, textarea:focus, select:focus {
  outline: none;
  border-color: var(--accent);
}

.error-text {
  color: var(--error);
  font-size: 0.875rem;
}

/* Presets */
.presets-group {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
  gap: 0.5rem;
}

.presets-group button {
  background-color: var(--border);
  color: #fff;
  border: none;
  padding: 0.5rem;
  border-radius: 4px;
  cursor: pointer;
}

.presets-group button:hover {
  background-color: var(--text-muted);
}

/* Settings Grid */
.settings-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.full-width {
  grid-column: 1 / -1;
}

.setting-item label {
  display: block;
  font-size: 0.875rem;
  margin-bottom: 0.5rem;
  color: var(--text-muted);
}

.color-picker-wrap {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.color-picker-wrap input[type="color"] {
  padding: 0;
  width: 40px;
  height: 40px;
  border: none;
  cursor: pointer;
}

input[type="range"] {
  width: 100%;
  cursor: pointer;
}

/* Sticky Preview */
.sticky-container {
  position: sticky;
  top: 2rem;
}

.preview-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.preview-card h2 {
  width: 100%;
  font-size: 1.25rem;
  margin-bottom: 1rem;
  color: #fff;
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.5rem;
  text-align: left;
}

.qr-wrapper {
  background-color: #fff;
  padding: 10px;
  border-radius: 8px;
  margin: 1rem 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.warning-banner {
  background-color: rgba(210, 153, 34, 0.15);
  color: var(--warning);
  padding: 0.75rem;
  border: 1px solid var(--warning);
  border-radius: 4px;
  font-size: 0.875rem;
  margin-bottom: 1rem;
  width: 100%;
}

/* Action Buttons */
.export-actions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  width: 100%;
  margin-top: 1rem;
}

.primary-btn, .secondary-btn {
  padding: 0.75rem;
  border-radius: 4px;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: background-color 0.2s;
}

.primary-btn {
  background-color: var(--accent);
  color: #fff;
}

.primary-btn:hover {
  background-color: var(--accent-hover);
}

.secondary-btn {
  background-color: var(--border);
  color: #fff;
}

.secondary-btn:hover {
  background-color: var(--text-muted);
}

/* History */
.history-card {
  margin-top: 1.5rem;
  background-color: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1rem;
}

.history-card h3 {
  font-size: 1rem;
  margin-bottom: 1rem;
  color: var(--text-muted);
}

.history-card ul {
  list-style: none;
}

.history-card li {
  display: flex;
  justify-content: space-between;
  padding: 0.75rem;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  font-size: 0.875rem;
}

.history-card li:last-child {
  border-bottom: none;
}

.history-card li:hover {
  background-color: var(--bg-main);
}

.history-type {
  font-weight: bold;
  text-transform: uppercase;
  color: var(--accent);
}