# Auto MPG Dataset: Exploratory Data Analysis & Preprocessing
#**Task 1: AI-ML Recruitment**

#**This notebook performs end-to-end data exploration, preprocessing, and analysis on the Auto MPG dataset to uncover trends in vehicle fuel efficiency, weight, and engine power.**

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings

# Suppress warnings for cleaner output
warnings.filterwarnings('ignore')

# 1. Dataset Loading
url = "https://archive.ics.uci.edu/ml/machine-learning-databases/auto-mpg/auto-mpg.data"
column_names = ['mpg', 'cylinders', 'displacement', 'horsepower', 'weight', 'acceleration', 'model_year', 'origin', 'car_name']

# Using sep=r'\s+' as delim_whitespace is deprecated in newer pandas versions
df = pd.read_csv(url, sep=r'\s+', names=column_names)

print("Dataset successfully loaded!")

## Part A - Data Exploration
#Initial overview of the dataset structure, data types, missing values, and summary statistics.
print("--- FIRST 5 ROWS ---")
display(df.head())

print("\n--- DATASET SHAPE ---")
print(f"Rows: {df.shape[0]}, Columns: {df.shape[1]}")

print("\n--- DATASET INFO ---")
df.info()

print("\n--- SUMMARY STATISTICS ---")
display(df.describe(include='all'))

print("\n--- MISSING VALUES ---")
# '?' is present as a string in horsepower, standard nulls might be 0 here
print(df.isnull().sum())

print("\n--- DUPLICATE ROWS ---")
print(f"Duplicate records: {df.duplicated().sum()}")

# Categorizing columns
numerical_cols = ['mpg', 'displacement', 'horsepower', 'weight', 'acceleration']
discrete_cols = ['cylinders', 'model_year', 'origin']
categorical_cols = ['car_name']

print(f"\nNumerical (Continuous): {numerical_cols}")
print(f"Numerical (Discrete): {discrete_cols}")
print(f"Categorical (Text): {categorical_cols}")

## Part B - Data Preprocessing
#Handling the erroneous '?' markers in the horsepower column, converting data types, and removing any duplicate entries to ensure data integrity.

# 1. Replace '?' with NaN in horsepower and convert to float
df['horsepower'] = df['horsepower'].replace('?', np.nan).astype(float)

# 2. Impute missing horsepower values with the median
hp_median = df['horsepower'].median()
df['horsepower'] = df['horsepower'].fillna(hp_median)

# 3. Check and drop duplicate records
duplicates_before = df.duplicated().sum()
df = df.drop_duplicates()

print("--- PREPROCESSING SUMMARY ---")
print(f"Replaced '?' with median horsepower: {hp_median}")
print(f"Duplicates dropped: {duplicates_before}")
print(f"Missing values remaining:\n{df.isnull().sum()}")
print(f"Final Dataset Shape: {df.shape}")

## Part C - Exploratory Data Analysis (EDA)
#Visualizing distributions, correlations, and relationships between categorical and numerical variables.

# Set visualization styling
sns.set_theme(style="whitegrid", palette="muted")

# 1. Distribution of MPG
plt.figure(figsize=(8, 5))
sns.histplot(df['mpg'], kde=True, bins=30, color='teal')
plt.title("Distribution of Miles Per Gallon (MPG)", fontsize=14)
plt.xlabel("MPG")
plt.ylabel("Frequency")
plt.show()

# 2. Subplots for displacement, horsepower, weight, and acceleration
fig, axes = plt.subplots(2, 2, figsize=(14, 10))
fig.suptitle("Distributions of Key Vehicle Features", fontsize=16)

sns.histplot(df['displacement'], kde=True, ax=axes[0,0], color='blue')
axes[0,0].set_title('Displacement')

sns.histplot(df['horsepower'], kde=True, ax=axes[0,1], color='red')
axes[0,1].set_title('Horsepower')

sns.histplot(df['weight'], kde=True, ax=axes[1,0], color='green')
axes[1,0].set_title('Weight')

sns.histplot(df['acceleration'], kde=True, ax=axes[1,1], color='purple')
axes[1,1].set_title('Acceleration')
plt.tight_layout()
plt.show()

# 3. Scatter plots with regression trendlines
fig, axes = plt.subplots(1, 3, figsize=(18, 5))
sns.regplot(x='weight', y='mpg', data=df, ax=axes[0], scatter_kws={'alpha':0.5}, line_kws={'color':'red'})
axes[0].set_title('MPG vs Weight')

sns.regplot(x='horsepower', y='mpg', data=df, ax=axes[1], scatter_kws={'alpha':0.5}, line_kws={'color':'red'})
axes[1].set_title('MPG vs Horsepower')

sns.regplot(x='displacement', y='mpg', data=df, ax=axes[2], scatter_kws={'alpha':0.5}, line_kws={'color':'red'})
axes[2].set_title('MPG vs Displacement')
plt.tight_layout()
plt.show()

# 4. Boxplots for origin and cylinders
df['origin_mapped'] = df['origin'].map({1: 'USA', 2: 'Europe', 3: 'Japan'})

fig, axes = plt.subplots(1, 2, figsize=(14, 5))
sns.boxplot(x='origin_mapped', y='mpg', data=df, ax=axes[0], palette='Set2')
axes[0].set_title('MPG Distribution by Origin')
axes[0].set_xlabel('Origin')

sns.boxplot(x='cylinders', y='mpg', data=df, ax=axes[1], palette='Set3')
axes[1].set_title('MPG Distribution by Cylinders')
axes[1].set_xlabel('Number of Cylinders')
plt.tight_layout()
plt.show()

# 5. Correlation Heatmap (numerical columns only)
plt.figure(figsize=(10, 8))
corr_matrix = df.select_dtypes(include=[np.number]).corr()
sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', fmt=".2f", linewidths=0.5)
plt.title("Correlation Heatmap of Numerical Features", fontsize=14)
plt.show()

# 6. Identifying Outliers using IQR (Acceleration)
Q1 = df['acceleration'].quantile(0.25)
Q3 = df['acceleration'].quantile(0.75)
IQR = Q3 - Q1
lower_bound = Q1 - 1.5 * IQR
upper_bound = Q3 + 1.5 * IQR

outliers = df[(df['acceleration'] < lower_bound) | (df['acceleration'] > upper_bound)]
print("\n--- OUTLIER OBSERVATIONS (Acceleration) ---")
print(f"Identified {len(outliers)} outliers outside bounds [{lower_bound:.2f}, {upper_bound:.2f}].")
display(outliers[['car_name', 'acceleration', 'mpg', 'horsepower']].head())

## Part D - Individual Analysis
#**Question:** How did average fuel efficiency (MPG) evolve from 1970 to 1982, and was it accompanied by changes in vehicle weight and engine power?

from sklearn.preprocessing import MinMaxScaler

# Aggregate data by model year
yearly_trends = df.groupby('model_year')[['mpg', 'weight', 'horsepower']].mean().reset_index()

# Normalize the data for multi-line comparison on the same y-axis scale
scaler = MinMaxScaler()
yearly_trends[['mpg_norm', 'weight_norm', 'hp_norm']] = scaler.fit_transform(yearly_trends[['mpg', 'weight', 'horsepower']])

# Plotting the normalized trends
plt.figure(figsize=(10, 6))
plt.plot(yearly_trends['model_year'], yearly_trends['mpg_norm'], marker='o', linewidth=2, label='MPG (Normalized)', color='green')
plt.plot(yearly_trends['model_year'], yearly_trends['weight_norm'], marker='s', linewidth=2, label='Weight (Normalized)', color='red')
plt.plot(yearly_trends['model_year'], yearly_trends['hp_norm'], marker='^', linewidth=2, label='Horsepower (Normalized)', color='orange')

plt.title("Evolution of Vehicle MPG, Weight, and Power (1970 - 1982)", fontsize=15)
plt.xlabel("Model Year (19XX)", fontsize=12)
plt.ylabel("Normalized Scale (0 to 1)", fontsize=12)
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.xticks(yearly_trends['model_year'])
plt.show()

#**Conclusion:**

## Part E - Insights & Export

print("--- KEY FINDINGS ---")
insights = [
    "1. Negative Correlation: Weight, displacement, and horsepower have a strong negative correlation with MPG (all above -0.77), indicating heavier, more powerful cars consume more fuel.",
    "2. Positive Correlation: MPG and model year show a positive correlation (0.58), meaning newer cars became progressively more fuel-efficient over time.",
    "3. Regional Differences: Japanese cars (Origin 3) have the highest median MPG, while American cars (Origin 1) have the lowest and tend to be heavier.",
    "4. Cylinder Impact: 4-cylinder engines overwhelmingly dominate the high-MPG tier, whereas 8-cylinder engines are tightly clustered at the lowest fuel efficiency levels.",
    "5. Evolutionary Shift: From 1970 to 1982, automakers sharply reduced vehicle weight and engine power to strictly prioritize and improve fuel economy.",
    "6. Acceleration Variability: Acceleration shows the weakest correlation with MPG compared to other physical attributes, functioning as a poor standalone predictor of fuel economy.",
    "7. Missing Data Strategy: The '?' markers in horsepower represented ~1.5% of the data; imputing them with the median (93.5) successfully preserved dataset integrity without skewing trends.",
    "8. Outlier Presence: A few cars (like the Peugeot 504 and VW Pickup) possess exceptionally slow acceleration profiles (>21.9s), resting clearly outside the upper IQR bounds."
]

for insight in insights:
    print(insight)

# Drop the temporary mapping column before export
df_export = df.drop(columns=['origin_mapped'])

# Export to CSV
export_filename = 'cleaned_auto_mpg.csv'
df_export.to_csv(export_filename, index=False)
print(f"\nData successfully exported to {export_filename}")

